steps:
  - name: 'python:3.10'
    entrypoint: 'pip'
    args: ['install', 'flake8']

  - name: 'python:3.10'
    entrypoint: 'flake8'
    args: ['main.py']

  - name: 'gcr.io/cloud-builders/docker'
    args: ['build', '-t', 'gcr.io/$PROJECT_ID/csv-metrics-service', '.']

  - name: 'gcr.io/cloud-builders/docker'
    args: ['push', 'gcr.io/$PROJECT_ID/csv-metrics-service']

  - name: 'gcr.io/cloud-builders/gcloud'
    args:
      [
        'run', 'deploy', 'csv-metrics-service',
        '--image', 'gcr.io/$PROJECT_ID/csv-metrics-service',
        '--region', 'us-central1',
        '--platform', 'managed',
        '--no-allow-unauthenticated'
      ]
